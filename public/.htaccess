# Принудительный HTTPS: сертификат на Беггете подключён и работает.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 301: /index.html -> / (канонический URL без index.html, чтобы Яндекс и Google
# не индексировали два разных адреса одной и той же главной страницы).
RewriteRule ^index\.html$ / [R=301,L]
