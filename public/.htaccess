# Канонизация URL: один адрес — одна страница (SEO, против дублей в индексе).
RewriteEngine On

# Служебные файлы наружу не отдаём. FTP-Deploy-Action кладёт в корень сайта
# .ftp-deploy-sync-state.json — полный перечень всех файлов сайта с хешами,
# 660+ КБ. Удалять нельзя (без него следующий деплой сделает полную пересинхру),
# но и отдавать краулерам незачем: это и лишний вес в обходе, и опись
# внутренней структуры. Правило закрывает заодно все точечные файлы (.git,
# .env), если они когда-нибудь окажутся в корне.
#
# Обе ветки обязательны: Require — синтаксис Apache 2.4, Order/Deny — 2.2.
# Незнакомая директива без обёртки IfModule роняет весь сайт в 500, поэтому
# каждая закрыта проверкой наличия модуля.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 0. Перенос двух калькуляторов с 3-го уровня на 2-й (август 2026).
#    Было:  /po-date-rozhdeniya/matrica-sudby-sovmestimost/...
#           /po-date-rozhdeniya/numerologiya-sovmestimost/...
#    Стало: /matrica-sudby-sovmestimost/...  /numerologiya-sovmestimost/...
#
#    Блок стоит ПЕРВЫМ, до канонизации хоста: подстановка здесь — абсолютный
#    канонический URL (https, без www), поэтому старый путь, запрошенный с www
#    или по http, чинится ОДНИМ 301, а не цепочкой «сначала хост, потом путь».
#    [L] обрывает обработку. Петли нет: новые пути не начинаются с
#    po-date-rozhdeniya/, поэтому правило не может сработать на свой результат.
#    Хаб /po-date-rozhdeniya/ не затрагивается — оба шаблона требуют после него
#    подкаталог с конкретным именем. Query string сохраняется автоматически.

#    0.1. Раздел БЕЗ завершающего слэша — сразу на новый URL СО слэшем,
#         иначе mod_dir добавил бы слэш вторым редиректом (цепочка из двух).
RewriteRule ^po-date-rozhdeniya/(matrica-sudby-sovmestimost|numerologiya-sovmestimost)$ https://magialove.ru/$1/ [R=301,L,NE]

#    0.2. Раздел со слэшем и всё вложенное одним правилом: /arkany/7/, /karta/,
#         /rezultat/, /psihomatritsa/, /chislo-zhiznennogo-puti/11/.
RewriteRule ^po-date-rozhdeniya/(matrica-sudby-sovmestimost|numerologiya-sovmestimost)/(.*)$ https://magialove.ru/$1/$2 [R=301,L,NE]

# 1. Канонический хост: https:// без www — одним 301-редиректом без цепочек.
#    Ловит все три неканонических варианта: http://www, https://www, http://.
#    $1 в per-directory контексте уже без ведущего слэша и со схлопнутыми
#    повторными слэшами — заодно чинит и их за один переход.
RewriteCond %{HTTP_HOST} ^www\.magialove\.ru$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://magialove.ru/$1 [R=301,L,NE]

# 2. /index.html в любом каталоге -> URL без index.html.
#    Условие по THE_REQUEST: срабатывает только на явный запрос клиента,
#    а не на внутренний DirectoryIndex-подзапрос (иначе была бы петля).
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ https://magialove.ru/$1 [R=301,L,NE]

# 3. Повторяющиеся слэши (//razdel//, /razdel//page/) -> одинарные.
#    THE_REQUEST хранит сырой запрос со слэшами, а путь в RewriteRule
#    Apache уже схлопнул — подставляем его как канонический.
RewriteCond %{THE_REQUEST} \s[^?\s]*//
RewriteRule ^(.*)$ https://magialove.ru/$1 [R=301,L,NE]
